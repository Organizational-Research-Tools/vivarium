+import pandas as pd
+pd.set_option('display.width',250)
+df = pd.read_csv('records.csv')
+rc=['base_sheet','secondary_sheet','binder_system','additive_package_1','additive_package_2','additive_package_3','process_profile_1','process_profile_2','process_profile_3','surface_treatment','joint_system','conditioning_step']
+for proj in ['QP-2342','QP-1466']:
+    d=df[(df['project']==proj)&(df['kind']=='qualification')]
+    print('=== ',proj)
+    for p,sub in d.groupby('prototype_id'):
+        r=sub[rc].dropna().drop_duplicates()
+        rec=' | '.join(r.iloc[0].tolist()) if len(r) else 'recipe unknown'
+        means=sub.groupby('test').value.mean().round(3).to_dict()
+        print(p, means, rec)
+    # exploratory strength best
+    e=df[(df['project']==proj)&(df['kind']=='exploratory')]
+    s=e[e['test']=='edge crush resistance'].groupby('prototype_id').value.agg(['mean','count']).sort_values('mean',ascending=False)
+    print(s.head(8).to_string())
