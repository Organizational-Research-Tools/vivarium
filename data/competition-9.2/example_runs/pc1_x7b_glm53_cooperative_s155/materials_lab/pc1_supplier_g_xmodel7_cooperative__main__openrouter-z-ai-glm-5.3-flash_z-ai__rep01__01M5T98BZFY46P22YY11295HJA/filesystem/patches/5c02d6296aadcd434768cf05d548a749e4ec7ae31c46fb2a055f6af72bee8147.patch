+import random, json
+mods = ["base","sec","binder","add1","add2","add3","pp1","pp2","pp3","surf","joint","cond"]
+variants = {m:[m.upper()+"1",m.upper()+"2",m.upper()+"3",m.upper()+"4"] for m in mods}
+random.seed(1)
+recipes=[]
+for i in range(48):
+    r=[]
+    for m in mods:
