+
+heat_base = 77.5
+heat_step = 0.25
+heat_req = 78.625  # = 77.5 + 4.5*0.25
+
+strength_base = 7.1
+strength_step = 0.03
+strength_req = 7.235  # = 7.1 + 4.5*0.03
+
+water_base = 78.0
