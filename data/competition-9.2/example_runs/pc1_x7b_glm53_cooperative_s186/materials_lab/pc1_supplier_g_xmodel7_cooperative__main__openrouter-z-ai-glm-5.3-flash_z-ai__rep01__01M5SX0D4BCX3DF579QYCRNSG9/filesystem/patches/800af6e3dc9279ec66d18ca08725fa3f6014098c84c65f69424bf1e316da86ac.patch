+import pandas as pd
+df = pd.read_csv('records.csv')
+s = df[(df.project=='QP-8476')&(df.test=='strength')].copy()
+s['v']=pd.to_numeric(s.value)
+g=s.groupby('prototype_id')['v'].mean().sort_values(ascending=False)
+cols=['base_sheet','secondary_sheet','binder_system','additive_package_1','additive_package_2','additive_package_3','process_profile_1','process_profile_2','process_profile_3','surface_treatment','joint_system','conditioning_step']
+protos=s.drop_duplicates('prototype_id')[['prototype_id']+cols].set_index('prototype_id')
+out=protos.join(g).sort_values('v',ascending=False)
+print(out.to_string())
+# marginal effects
+print('--- marginal effects (mean over recipes containing variant, strength, QP-8476 only) ---')
+for c in cols:
+    m=s.merge(protos[c].reset_index(),on='prototype_id')
+    print(m.groupby(c+'_x')['v'].agg(['mean','count']).sort_values('mean',ascending=False).to_string().replace('\n',' | '), '  ', c)