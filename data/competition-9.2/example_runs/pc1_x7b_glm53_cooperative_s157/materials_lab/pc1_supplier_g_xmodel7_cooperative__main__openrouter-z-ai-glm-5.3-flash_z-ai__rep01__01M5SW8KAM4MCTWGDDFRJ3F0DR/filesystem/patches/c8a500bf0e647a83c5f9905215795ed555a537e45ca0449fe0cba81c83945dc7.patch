+import pandas as pd
+df=pd.read_csv('records.csv')
+# exploratory water readings on QP-6820 & QP-5653 variants registered recently, and QP-2236/5066/2347/3068
+for proj in ['QP-6820','QP-5653','QP-2236','QP-2347','QP-3068','QP-5066']:
+    w=df[(df.project==proj)&(df.test=='wet strength retained')&(df.kind=='exploratory')]
+    if len(w): print(proj, w.groupby('prototype_id').value.agg(['mean','count']).sort_values('mean',ascending=False).head(8).round(2).to_dict())
