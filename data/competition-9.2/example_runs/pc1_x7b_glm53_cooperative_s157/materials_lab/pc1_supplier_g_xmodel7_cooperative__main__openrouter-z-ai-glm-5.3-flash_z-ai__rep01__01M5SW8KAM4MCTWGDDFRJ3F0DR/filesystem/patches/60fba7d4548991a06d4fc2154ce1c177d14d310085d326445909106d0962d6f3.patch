+import pandas as pd, numpy as np
+df=pd.read_csv("records.csv")
+q=df[df.kind=='qualification']
+modcols=['base_sheet','secondary_sheet','binder_system','additive_package_1','additive_package_2','additive_package_3','process_profile_1','process_profile_2','process_profile_3','surface_treatment','joint_system','conditioning_step']
+g=q.groupby(['prototype_id','test']).value.agg(['count','mean']).reset_index()
+panels=g[g['count']==6].merge(q.drop_duplicates('prototype_id')[['prototype_id']+modcols],on='prototype_id')
+rec=df[df.kind=='exploratory']
+# module marginal means per test from all records (exploratory included)
+for t in ['seal hold temperature','edge crush resistance','wet strength retained']:
+    d=df[df.test==t]
+    print("==",t, len(d))
