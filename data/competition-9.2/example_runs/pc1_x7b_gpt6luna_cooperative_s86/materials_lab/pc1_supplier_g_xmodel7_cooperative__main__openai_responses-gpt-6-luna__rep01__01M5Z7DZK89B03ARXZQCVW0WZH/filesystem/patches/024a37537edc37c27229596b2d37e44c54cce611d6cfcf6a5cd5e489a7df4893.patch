+import pandas as pd
+x=pd.read_csv('records.csv')
+q=x[x.kind.eq('qualification')]
+g=q.groupby(['prototype_id','project','test']).agg(n=('value','count'),mean=('value','mean'),by=('measured_by','first'))
+print('projects', q.groupby('project').prototype_id.nunique().to_dict())
+# wide panel complete on H/W and pass revision B, S absent/incomplete
+w=g[g.n>=6].reset_index().pivot(index=['prototype_id','project'],columns='test',values=['n','mean'])
+# flatten
+w.columns=['_'.join(str(z) for z in c) for c in w.columns]
+print(w.columns.tolist())
+H='mean_seal hold temperature'; S='mean_edge crush resistance'; W='mean_wet strength retained'
+cands=w[(w.get('n_seal hold temperature',0)>=6)&(w.get('n_wet strength retained',0)>=6)&(w[H]>=78.25)&(w[W]>=79.2)&((w.get('mean_edge crush resistance',-99)<7.19)|(w.get('n_edge crush resistance',0)<6))]
+print('promising H+W',len(cands))
+print(cands.sort_values(W,ascending=False).head(50).to_string())