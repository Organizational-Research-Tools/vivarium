+import pandas as pd
+x=pd.read_csv('records.csv')
+cols=['base_sheet','secondary_sheet','binder_system','additive_package_1','additive_package_2','additive_package_3','process_profile_1','process_profile_2','process_profile_3','surface_treatment','joint_system','conditioning_step']
+q=x[x.kind=='qualification']
+g=q.groupby(cols+['test','prototype_id']).value.mean().reset_index()
+r=g.groupby(cols+['test']).agg(n=('prototype_id','nunique'), sd=('value','std'), lo=('value','min'), hi=('value','max')).reset_index()
+print(r[r.n>1].sort_values('n',ascending=False).to_string(index=False))