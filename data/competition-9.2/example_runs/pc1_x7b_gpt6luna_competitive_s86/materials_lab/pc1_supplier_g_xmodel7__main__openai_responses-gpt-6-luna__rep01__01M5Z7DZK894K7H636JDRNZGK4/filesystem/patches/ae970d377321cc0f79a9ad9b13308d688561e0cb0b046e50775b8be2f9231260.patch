+import pandas as pd
+x=pd.read_csv('records.csv')
+# aggregate recipe/project per prototype/test; show all qualification complete or partial for recent QP3617
+q=x[x['project'].eq('QP-3617')]
+print(q.groupby(['prototype_id','test','kind']).agg(n=('value','size'),mean=('value','mean'),owner=('measured_by','first')).to_string())
+print('\nrecipes')
+print(q.groupby('prototype_id').first()[['base_sheet','secondary_sheet','binder_system','additive_package_1','additive_package_2','additive_package_3','process_profile_1','process_profile_2','process_profile_3','surface_treatment','joint_system','conditioning_step']].to_string())