+import pandas as pd
+x=pd.read_csv('records.csv')
+cols=['base_sheet','secondary_sheet','binder_system','additive_package_1','additive_package_2','additive_package_3','process_profile_1','process_profile_2','process_profile_3','surface_treatment','joint_system','conditioning_step']
+for pr in ['QP-3617','QP-6879']:
+ z=x[x.project.eq(pr)].dropna(subset=cols[0]).copy()
+ z['value']=pd.to_numeric(z.value,errors='coerce')
+ # grouped means by proto, test; print recipe and mean
+ g=z.groupby(['prototype_id','instrument','kind'],dropna=False).agg(means=('value','mean'),n=('value','size')).reset_index()
+ rec=z[['prototype_id']+cols].drop_duplicates('prototype_id').set_index('prototype_id')
+ print('\n',pr)
+ for pid,gg in g.groupby('prototype_id'):
+  r=rec.loc[pid].tolist()
+  print(pid,gg[['instrument','kind','means']].values.tolist(),r)
