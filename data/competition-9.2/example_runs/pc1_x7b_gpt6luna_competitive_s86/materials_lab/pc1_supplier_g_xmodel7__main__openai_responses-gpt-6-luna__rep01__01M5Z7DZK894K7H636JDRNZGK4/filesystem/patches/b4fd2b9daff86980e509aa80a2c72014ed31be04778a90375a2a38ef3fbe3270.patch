+import pandas as pd
+x=pd.read_csv('records.csv')
+q=x[(x.project=='QP-3617') & (x.prototype_id.str.startswith(('p_CD8','p_SB5','p_1R7')))]
+mods=['base_sheet','secondary_sheet','binder_system','additive_package_1','additive_package_2','additive_package_3','process_profile_1','process_profile_2','process_profile_3','surface_treatment','joint_system','conditioning_step']
+for p,g in q.groupby('prototype_id'):
+  r=g.drop_duplicates(mods)
+  v=dict(zip(mods,r.iloc[0][mods])) if len(r) else {}
+  print(p, v.get('additive_package_2'),v.get('additive_package_3'),
+        '; '.join(f"{t}:{','.join(f'{a.measured_by}={a.value:.4f}' for _,a in g[g.test==t].iterrows())}" for t in g.test.unique()))